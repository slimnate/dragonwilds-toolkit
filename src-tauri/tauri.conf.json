{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dragonwilds Toolkit",
  "version": "1.0.0",
  "identifier": "dev.rsdw.save-editor",
  "mainBinaryName": "DragonwildsToolkit",
  "build": {
    "beforeDevCommand": "npm run catalog:pack && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run catalog:pack && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dragonwilds Toolkit",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
